# Postgres connection string (Neon or Supabase). Required.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Password that protects the whole app. Leave empty to disable (local development only).
APP_PASSWORD=

# Secret that Vercel Cron sends to /api/cron/rankings. Any long random string.
CRON_SECRET=

# Anthropic API key for the AI keyword ideas. Optional: without it the rest of the app works.
ANTHROPIC_API_KEY=

# Weekly summary email through Resend (optional). ALERT_EMAIL is where it goes.
RESEND_API_KEY=
ALERT_EMAIL=
# EMAIL_FROM="Rankeo <aso@tudominio.com>"   # needs a domain verified in Resend
# APP_URL=https://tu-app.vercel.app         # links in the email; Vercel sets it automatically
