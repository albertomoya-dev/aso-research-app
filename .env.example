# Postgres connection string (Neon or Supabase). Required.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Password that protects the whole app. Leave empty to disable (local development only).
APP_PASSWORD=

# Secret that Vercel Cron sends to /api/cron/rankings. Any long random string.
CRON_SECRET=

# Anthropic API key for the AI keyword ideas. Optional: without it the rest of the app works.
ANTHROPIC_API_KEY=

# Weekly summary email through Resend (optional). ALERT_EMAIL is where it goes.
RESEND_API_KEY=
ALERT_EMAIL=
# EMAIL_FROM="Rankeo <aso@tudominio.com>"   # needs a domain verified in Resend
# APP_URL=https://tu-app.vercel.app         # links in the email; Vercel sets it automatically

# Logos con IA generativa (opcional). Con una de las dos claves basta; IMAGE_PROVIDER fuerza cuál usar.
# IMAGE_PROVIDER=openai           # openai | gemini
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-2.5-flare (o gpt-image-2.5-sunburst)  # OPENAI_IMAGE_QUALITY=medium (low | medium | high)
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image   # o imagen-4.0-generate-001

# Google Play Console (opcional). Clave JSON de una cuenta de servicio con acceso a tus apps en Play Console
# (Usuarios y permisos). Pega el JSON tal cual o codificado en base64. Solo se lee en el servidor: nunca se
# envía al navegador ni se escribe en los logs. Sin ella, todo lo demás funciona igual.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Solo lectura por defecto. Con 1, Rankeo puede publicar la ficha y responder reseñas, siempre con vista
# previa y confirmación en la pantalla.
# GOOGLE_PLAY_ALLOW_WRITE=1
